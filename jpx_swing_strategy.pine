//@version=6

// ════════════════════════════════════════════════════════════
//  JPX スイング戦略 v1
//
//  設計目標
//    プロフィットファクター  1.6 以上
//    最大ドローダウン        -12% 以内
//    スイング主体・利が乗れば中長期へ延長
//
//  エントリーシグナル（4 種類 OR 結合、共通フィルター全通過で発火）
//    S1 : EMA5 が EMA25 を上抜け（短期ゴールデンクロス）
//    S2 : 上昇トレンド中の EMA5 押し目回復
//    S3 : 20 日高値ブレイクアウト
//    S4 : RSI が 50 を上抜け（押し目後のモメンタム回復）
//
//  イグジット（3 段階 ATR トレーリングストップ）
//    S1  含み益 < 5%    → 直近高値 - 2.0 × ATR
//    S2  含み益 5-12%   → 直近高値 - 2.5 × ATR  ← 利を延ばすフェーズ
//    S3  含み益 ≥ 12%   → 直近高値 - 3.2 × ATR  ← 中長期保有フェーズ
//    ハードストップ     : エントリー価格 × (1 - 8%)
//    タイムストップ     : 12 バー経過 かつ 含み益 < 0.5%
//
//  ポジションサイズ
//    リスク per トレード : 資産の 1.2%
//    株数 = floor( (資産 × 1.2%) / (2.0 × ATR) )
//    上限 : 資産の 10% を超えない
//
//  注意 : TradingView は 1 チャート = 1 銘柄。
//         Python 版の複数銘柄ポートフォリオとは異なり、
//         各銘柄のチャートに本スクリプトを個別に適用してください。
// ════════════════════════════════════════════════════════════

strategy(
    title             = "JPX スイング戦略 v1",
    shorttitle        = "JPX-Swing",
    overlay           = true,
    initial_capital   = 10000000,
    currency          = currency.JPY,
    default_qty_type  = strategy.fixed,
    default_qty_value = 100,
    commission_type   = strategy.commission.percent,
    commission_value  = 0.1,
    slippage          = 2,
    pyramiding        = 0
)

// ────────────────────────────────────────────
//  入力パラメータ
// ────────────────────────────────────────────
// ── インジケーター ──
i_ema_fast    = input.int  (5,    "EMA Fast 期間",        group="📊 インジケーター", minval=2,  maxval=20)
i_ema_mid     = input.int  (25,   "EMA Mid 期間",         group="📊 インジケーター", minval=10, maxval=60)
i_ema_slow    = input.int  (75,   "EMA Slow 期間",        group="📊 インジケーター", minval=30, maxval=200)
i_rsi_len     = input.int  (14,   "RSI 期間",             group="📊 インジケーター", minval=2,  maxval=30)
i_atr_len     = input.int  (14,   "ATR 期間",             group="📊 インジケーター", minval=2,  maxval=30)
i_vol_ma_len  = input.int  (20,   "出来高 MA 期間",       group="📊 インジケーター", minval=5,  maxval=60)

// ── エントリーフィルター ──
i_rsi_lo      = input.float(40.0, "RSI 下限",             group="🎯 エントリーフィルター", minval=10,  maxval=60,  step=1.0)
i_rsi_hi      = input.float(72.0, "RSI 上限",             group="🎯 エントリーフィルター", minval=50,  maxval=90,  step=1.0)
i_vol_mult    = input.float(1.2,  "出来高 倍率（MA 比）", group="🎯 エントリーフィルター", minval=0.5, maxval=4.0, step=0.1)
i_max_atr_pct = input.float(7.0,  "最大 ATR/Close %",     group="🎯 エントリーフィルター", minval=1.0, maxval=20.0,step=0.5) / 100.0

// ── イグジット ──
i_atr_s1      = input.float(2.0,  "ATR 乗数 S1  (含み益 < 5%)",   group="🚪 イグジット", minval=0.5, maxval=8.0, step=0.1)
i_atr_s2      = input.float(2.5,  "ATR 乗数 S2  (5-12%)",         group="🚪 イグジット", minval=0.5, maxval=8.0, step=0.1)
i_atr_s3      = input.float(3.2,  "ATR 乗数 S3  (≥ 12%)",         group="🚪 イグジット", minval=0.5, maxval=8.0, step=0.1)
i_profit_s2   = input.float(5.0,  "S2 移行 利益 %",               group="🚪 イグジット", minval=1.0, maxval=50.0,step=0.5) / 100.0
i_profit_s3   = input.float(12.0, "S3 移行 利益 %",               group="🚪 イグジット", minval=1.0, maxval=80.0,step=0.5) / 100.0
i_hard_stop   = input.float(8.0,  "ハードストップ %",             group="🚪 イグジット", minval=1.0, maxval=25.0,step=0.5) / 100.0
i_time_bars   = input.int  (12,   "タイムストップ バー数",         group="🚪 イグジット", minval=1,   maxval=60)
i_time_ret    = input.float(0.5,  "タイムストップ 利益% 閾値",    group="🚪 イグジット", minval=0.0, maxval=10.0,step=0.1) / 100.0

// ── ポジション管理 ──
i_risk_pct    = input.float(1.2,  "リスク % / トレード",          group="💰 ポジション管理", minval=0.1, maxval=10.0,step=0.1) / 100.0
i_atr_risk    = input.float(2.0,  "ATR リスク乗数",               group="💰 ポジション管理", minval=0.5, maxval=6.0, step=0.1)
i_max_alloc   = input.float(10.0, "1 銘柄 最大配分 %",            group="💰 ポジション管理", minval=1.0, maxval=100.0,step=1.0) / 100.0

// ────────────────────────────────────────────
//  指標計算
// ────────────────────────────────────────────
ema_fast  = ta.ema(close, i_ema_fast)
ema_mid   = ta.ema(close, i_ema_mid)
ema_slow  = ta.ema(close, i_ema_slow)
rsi_val   = ta.rsi(close, i_rsi_len)
atr_val   = ta.atr(i_atr_len)
vol_ma    = ta.sma(volume, i_vol_ma_len)

// ────────────────────────────────────────────
//  エントリーシグナル
// ────────────────────────────────────────────
// S1 : EMA5 が EMA25 を上抜け（ゴールデンクロス）
sig1 = ta.crossover(ema_fast, ema_mid)

// S2 : 上昇トレンド中の押し目回復
//      条件: EMA5>EMA25、前日終値≤前日EMA5（押し目）、当日終値>EMA5（回復）
sig2 = ema_fast > ema_mid and close[1] <= ema_fast[1] and close > ema_fast

// S3 : 20 日高値ブレイクアウト（前日までの 20 日最高値を更新）
sig3 = close > ta.highest(close[1], 20) and ema_fast > ema_mid

// S4 : RSI が 50 を上抜け（上昇トレンド中のモメンタム回復）
sig4 = ta.crossover(rsi_val, 50) and close > ema_mid and ema_fast > ema_mid

// ── 共通フィルター（全条件充足必須）──
filt_trend  = close > ema_slow                          // 中期上昇トレンド確認
filt_rsi    = rsi_val >= i_rsi_lo and rsi_val <= i_rsi_hi
filt_vol    = volume  >= vol_ma   * i_vol_mult           // 出来高確認
filt_atr    = atr_val / close     <= i_max_atr_pct       // 過度なボラ除外

entry_cond  = (sig1 or sig2 or sig3 or sig4) and filt_trend and filt_rsi and filt_vol and filt_atr

// ────────────────────────────────────────────
//  状態変数（ポジション保有中に更新）
// ────────────────────────────────────────────
var float v_trail_stop = na   // トレーリングストップ価格
var float v_peak       = na   // エントリー後の最高終値（ストップ基準）
var int   v_entry_bar  = na   // エントリーバーのインデックス
var float v_final_stop = na   // ハードストップを考慮した最終ストップ

in_long = strategy.position_size > 0

// ポジション解消時にリセット
if not in_long
    v_trail_stop := na
    v_peak       := na
    v_entry_bar  := na
    v_final_stop := na

// ────────────────────────────────────────────
//  ポジションサイズ計算
// ────────────────────────────────────────────
// 株数 = floor( (資産 × リスク%) / (ATR乗数 × ATR) )  ← ATR リスクベース
// ただし 1 銘柄最大配分 % を超えないよう上限設定
risk_per_sh = i_atr_risk  * atr_val
raw_qty     = strategy.equity * i_risk_pct   / math.max(risk_per_sh, 0.0001)
max_qty     = strategy.equity * i_max_alloc  / math.max(close,        0.0001)
entry_qty   = math.floor(math.min(raw_qty, max_qty))

// ────────────────────────────────────────────
//  エントリー
// ────────────────────────────────────────────
entry_tag = sig1 ? "GC" : sig2 ? "PB" : sig3 ? "BO" : "RS"

if entry_cond and not in_long and entry_qty > 0
    strategy.entry("long", strategy.long, qty=entry_qty, comment=entry_tag)
    v_entry_bar  := bar_index
    v_peak       := close
    v_trail_stop := close - i_atr_s1 * atr_val   // 初期ストップ

// ────────────────────────────────────────────
//  イグジット
// ────────────────────────────────────────────
if in_long
    avg_px  = strategy.position_avg_price
    cur_ret = (close - avg_px) / avg_px

    // 高値更新（ストップの基準となるピーク）
    v_peak := math.max(nz(v_peak, avg_px), close)

    // 含み益ステージに応じた ATR 乗数を選択
    atr_mult = cur_ret >= i_profit_s3 ? i_atr_s3 : cur_ret >= i_profit_s2 ? i_atr_s2 : i_atr_s1

    // トレーリングストップ更新（下方には動かさない）
    new_trail    = v_peak - atr_mult * atr_val
    v_trail_stop := math.max(nz(v_trail_stop, new_trail), new_trail)

    // ハードストップ: エントリー価格 × (1 - 8%)
    hard_px      = avg_px * (1.0 - i_hard_stop)
    v_final_stop := math.max(v_trail_stop, hard_px)

    // タイムストップ: 指定バー数経過 かつ 含み益が閾値未満
    bars_held    = bar_index - nz(v_entry_bar, bar_index)
    do_time_exit = bars_held >= i_time_bars and cur_ret < i_time_ret

    if do_time_exit
        // タイムストップ: 翌バー寄り成行決済
        strategy.close("long", comment="TS")
    else
        // ATR トレーリング + ハードストップ
        exit_tag = cur_ret >= i_profit_s3 ? "S3" : cur_ret >= i_profit_s2 ? "S2" : "S1"
        strategy.exit("trail", from_entry="long", stop=v_final_stop, comment=exit_tag)

// ────────────────────────────────────────────
//  チャート描画
// ────────────────────────────────────────────
// EMA ライン
plot(ema_fast, "EMA5",  color=color.new(#2196F3, 0), linewidth=1)
plot(ema_mid,  "EMA25", color=color.new(#FF9800, 0), linewidth=1)
plot(ema_slow, "EMA75", color=color.new(#F44336, 0), linewidth=2)

// ストップライン（保有中のみ表示）
plot(v_final_stop, "トレールストップ",
     color     = color.new(color.red, 0),
     style     = plot.style_linebr,
     linewidth = 1)

// ピーク高値ライン（ストップ基準の最高値）
plot(in_long ? v_peak : na, "ピーク高値",
     color     = color.new(color.teal, 55),
     style     = plot.style_linebr,
     linewidth = 1)

// エントリーシグナル（三角マーク）
plotshape(entry_cond and not in_long,
          title    = "エントリーシグナル",
          style    = shape.triangleup,
          location = location.belowbar,
          color    = color.new(color.lime, 0),
          size     = size.small)

// シグナル種別ラベル
if entry_cond and not in_long
    label.new(
      bar_index, na,
      entry_tag,
      xloc      = xloc.bar_index,
      yloc      = yloc.belowbar,
      style     = label.style_label_up,
      color     = color.new(color.green, 55),
      textcolor = color.white,
      size      = size.tiny,
      tooltip   = "シグナル: " + entry_tag
                + "\nRSI: "    + str.tostring(math.round(rsi_val, 1))
                + "\nATR: "    + str.tostring(math.round(atr_val, 1))
                + "\n出来高比: " + str.tostring(math.round(volume / vol_ma, 2)) + "x")

// ステージ別背景色
//   緑: S1（含み益 < 5%）  青: S2（5-12%）  紫: S3（≥ 12%）
stage_ret = in_long ? (close - strategy.position_avg_price) / strategy.position_avg_price : na
bgcolor(stage_ret >= i_profit_s3 ? color.new(color.purple, 92) :
        stage_ret >= i_profit_s2 ? color.new(color.blue,   92) :
        in_long                   ? color.new(color.green,  95) : na,
        title="ステージ背景")

// ────────────────────────────────────────────
//  情報テーブル（右上に現在状態を表示）
// ────────────────────────────────────────────
var table info_table = table.new(position.top_right, 2, 6,
    bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1, frame_color=color.gray)

if barstate.islast
    avg_px_disp = strategy.position_avg_price
    cur_ret_pct = in_long ? (close - avg_px_disp) / avg_px_disp * 100 : 0.0
    string stage_str = "─"
    if in_long
        stage_str := cur_ret_pct / 100.0 >= i_profit_s3 ? "S3 中長期延長" : cur_ret_pct / 100.0 >= i_profit_s2 ? "S2 利益延長" : "S1 スイング"

    table.cell(info_table, 0, 0, "JPX-Swing",   text_color=color.silver, text_size=size.small)
    table.cell(info_table, 1, 0, "状態",         text_color=color.silver, text_size=size.small)
    table.cell(info_table, 0, 1, "ポジション",   text_color=color.gray,   text_size=size.tiny)
    table.cell(info_table, 1, 1, in_long ? "保有中" : "待機",
               text_color=in_long ? color.lime : color.gray, text_size=size.tiny)
    table.cell(info_table, 0, 2, "ステージ",     text_color=color.gray,   text_size=size.tiny)
    table.cell(info_table, 1, 2, stage_str,       text_color=color.white,  text_size=size.tiny)
    table.cell(info_table, 0, 3, "含み益",        text_color=color.gray,   text_size=size.tiny)
    table.cell(info_table, 1, 3, in_long ? str.tostring(math.round(cur_ret_pct, 2)) + "%" : "─",
               text_color=cur_ret_pct >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(info_table, 0, 4, "ストップ",      text_color=color.gray,   text_size=size.tiny)
    table.cell(info_table, 1, 4, in_long ? str.tostring(math.round(v_final_stop, 1)) : "─",
               text_color=color.red, text_size=size.tiny)
    table.cell(info_table, 0, 5, "保有バー数",    text_color=color.gray,   text_size=size.tiny)
    table.cell(info_table, 1, 5, in_long ? str.tostring(bar_index - nz(v_entry_bar, bar_index)) : "─",
               text_color=color.white, text_size=size.tiny)
