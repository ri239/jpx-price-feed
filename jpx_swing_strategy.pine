//@version=6

// ════════════════════════════════════════════════════════════
//  JPX スイング戦略 v2
//
//  設計目標
//    プロフィットファクター  1.6 以上
//    最大ドローダウン        -12% 以内
//    スイング主体・利が乗れば中長期へ延長
//
//  エントリーシグナル（4 種類 OR 結合、共通フィルター全通過で発火）
//    GC : EMA5 が EMA25 を上抜け（短期ゴールデンクロス）
//    PB : 上昇トレンド中の EMA5 押し目回復
//    BO : 20 日高値ブレイクアウト
//    RS : RSI が 50 を上抜け（押し目後のモメンタム回復）
//
//  イグジット（3 段階 ATR トレーリングストップ）
//    S1  含み益 < 5%    → 直近高値 - 2.0 × ATR
//    S2  含み益 5-12%   → 直近高値 - 2.5 × ATR  ← 利を延ばすフェーズ
//    S3  含み益 ≥ 12%   → 直近高値 - 3.2 × ATR  ← 中長期保有フェーズ
//    ハードストップ     : エントリー価格 × (1 - 8%)
//    タイムストップ     : 12 バー経過 かつ 含み益 < 0.5%
//
//  ポジションサイズ（ATR リスクベース）
//    株数 = floor( (資産 × 1.2%) / (2.0 × ATR) )  上限: 資産の 10%
//
//  注意: TradingView は 1 チャート = 1 銘柄。
//        各銘柄のチャートに本スクリプトを個別に適用してください。
// ════════════════════════════════════════════════════════════

strategy(
    title                = "JPX スイング戦略 v2",
    shorttitle           = "JPX-Swing",
    overlay              = true,
    initial_capital      = 10000000,
    currency             = currency.JPY,
    default_qty_type     = strategy.fixed,
    default_qty_value    = 100,
    commission_type      = strategy.commission.percent,
    commission_value     = 0.1,
    slippage             = 2,
    pyramiding           = 0,
    calc_on_every_tick   = false
)

// ════════════════════════════════════════════
//  入力パラメータ
// ════════════════════════════════════════════

// ── インジケーター ──────────────────────────
i_ema_fast   = input.int  (5,    "EMA Fast 期間",        group="📊 インジケーター", minval=2,   maxval=20)
i_ema_mid    = input.int  (25,   "EMA Mid 期間",         group="📊 インジケーター", minval=10,  maxval=60)
i_ema_slow   = input.int  (75,   "EMA Slow 期間",        group="📊 インジケーター", minval=30,  maxval=200)
i_rsi_len    = input.int  (14,   "RSI 期間",             group="📊 インジケーター", minval=2,   maxval=30)
i_atr_len    = input.int  (14,   "ATR 期間",             group="📊 インジケーター", minval=2,   maxval=30)
i_vol_len    = input.int  (20,   "出来高 MA 期間",       group="📊 インジケーター", minval=5,   maxval=60)

// ── エントリーフィルター ──────────────────────
i_rsi_lo     = input.float(40.0, "RSI 下限",             group="🎯 エントリーフィルター", minval=10,  maxval=60,   step=1.0)
i_rsi_hi     = input.float(72.0, "RSI 上限",             group="🎯 エントリーフィルター", minval=50,  maxval=90,   step=1.0)
i_vol_mult   = input.float(1.2,  "出来高倍率（MA 比）",  group="🎯 エントリーフィルター", minval=0.5, maxval=4.0,  step=0.1)
i_atr_max    = input.float(7.0,  "最大 ATR/Close %",     group="🎯 エントリーフィルター", minval=1.0, maxval=20.0, step=0.5) / 100.0

// ── イグジット ────────────────────────────────
i_atr_s1     = input.float(2.0,  "ATR 乗数 S1（< 5%）",  group="🚪 イグジット", minval=0.5, maxval=8.0, step=0.1)
i_atr_s2     = input.float(2.5,  "ATR 乗数 S2（5-12%）", group="🚪 イグジット", minval=0.5, maxval=8.0, step=0.1)
i_atr_s3     = input.float(3.2,  "ATR 乗数 S3（≥12%）",  group="🚪 イグジット", minval=0.5, maxval=8.0, step=0.1)
i_prof_s2    = input.float(5.0,  "S2 移行 利益 %",       group="🚪 イグジット", minval=1.0, maxval=50.0, step=0.5) / 100.0
i_prof_s3    = input.float(12.0, "S3 移行 利益 %",       group="🚪 イグジット", minval=1.0, maxval=80.0, step=0.5) / 100.0
i_hard_stop  = input.float(8.0,  "ハードストップ %",     group="🚪 イグジット", minval=1.0, maxval=25.0, step=0.5) / 100.0
i_time_bars  = input.int  (12,   "タイムストップ バー数", group="🚪 イグジット", minval=1,   maxval=60)
i_time_ret   = input.float(0.5,  "タイムストップ 利益% 閾値", group="🚪 イグジット", minval=0.0, maxval=10.0, step=0.1) / 100.0

// ── ポジション管理 ────────────────────────────
i_risk_pct   = input.float(1.2,  "リスク % / トレード",  group="💰 ポジション管理", minval=0.1, maxval=10.0,  step=0.1) / 100.0
i_atr_risk   = input.float(2.0,  "ATR リスク乗数",       group="💰 ポジション管理", minval=0.5, maxval=6.0,  step=0.1)
i_max_alloc  = input.float(10.0, "1 銘柄 最大配分 %",    group="💰 ポジション管理", minval=1.0, maxval=100.0, step=1.0) / 100.0

// ════════════════════════════════════════════
//  指標計算
// ════════════════════════════════════════════
ema_fast = ta.ema(close, i_ema_fast)
ema_mid  = ta.ema(close, i_ema_mid)
ema_slow = ta.ema(close, i_ema_slow)
rsi_v    = ta.rsi(close, i_rsi_len)
atr_v    = ta.atr(i_atr_len)
vol_ma   = ta.sma(volume, i_vol_len)

// ════════════════════════════════════════════
//  エントリーシグナル（4 種類）
// ════════════════════════════════════════════
// GC: EMA5 が EMA25 を上抜け（ゴールデンクロス）
sig_gc = ta.crossover(ema_fast, ema_mid)

// PB: 上昇トレンド中の押し目回復
//     EMA5 > EMA25 かつ 前日終値 ≤ 前日EMA5 かつ 当日終値 > EMA5
sig_pb = ema_fast > ema_mid and close[1] <= ema_fast[1] and close > ema_fast

// BO: 20 日高値ブレイクアウト（前日までの 20 日最高終値を本日終値が上回る）
sig_bo = close > ta.highest(close[1], 20) and ema_fast > ema_mid

// RS: RSI が 50 を上抜け（上昇トレンド中のモメンタム回復）
sig_rs = ta.crossover(rsi_v, 50) and close > ema_mid and ema_fast > ema_mid

// ── 共通フィルター（全条件充足が必須）──
f_trend = close > ema_slow
f_rsi   = rsi_v >= i_rsi_lo and rsi_v <= i_rsi_hi
f_vol   = volume >= vol_ma * i_vol_mult
f_atr   = atr_v / close <= i_atr_max

entry_ok = (sig_gc or sig_pb or sig_bo or sig_rs) and f_trend and f_rsi and f_vol and f_atr

// ════════════════════════════════════════════
//  状態変数
// ════════════════════════════════════════════
var float v_stop     = na  // 現在のトレーリングストップ価格
var float v_peak     = na  // エントリー後の最高終値（ストップ基準）
var int   v_bar      = na  // エントリーバーの bar_index
var float v_fstop    = na  // ハードストップ込みの最終ストップ

in_long = strategy.position_size > 0

// ポジション解消時にリセット
if not in_long
    v_stop  := na
    v_peak  := na
    v_bar   := na
    v_fstop := na

// ════════════════════════════════════════════
//  ポジションサイズ計算（ATR リスクベース）
// ════════════════════════════════════════════
// 株数 = floor( 資産×リスク% / (ATR乗数×ATR) )  ← 1ATR 乗数分のリスクが資産の risk_pct に相当
// ただし 1 銘柄への最大配分 % を上限とする
_risk_sh = i_atr_risk * atr_v
_raw_qty = strategy.equity * i_risk_pct  / math.max(_risk_sh, 0.0001)
_max_qty = strategy.equity * i_max_alloc / math.max(close,    0.0001)
entry_qty = math.floor(math.min(_raw_qty, _max_qty))

// ════════════════════════════════════════════
//  エントリー
// ════════════════════════════════════════════
sig_tag = sig_gc ? "GC" : sig_pb ? "PB" : sig_bo ? "BO" : "RS"

if entry_ok and not in_long and entry_qty > 0
    strategy.entry("long", strategy.long, qty=entry_qty, comment=sig_tag)
    v_bar  := bar_index
    v_peak := close
    v_stop := close - i_atr_s1 * atr_v   // 初期ストップ

// ════════════════════════════════════════════
//  イグジット（3 段階 ATR トレーリング ＋ ハードストップ ＋ タイムストップ）
// ════════════════════════════════════════════
if in_long
    _avg    = strategy.position_avg_price
    _ret    = (close - _avg) / _avg

    // ① 高値更新（ストップ基準となるピーク）
    v_peak := math.max(nz(v_peak, _avg), close)

    // ② ステージ別 ATR 乗数（含み益に応じて段階的に拡大）
    _mult = _ret >= i_prof_s3 ? i_atr_s3 : _ret >= i_prof_s2 ? i_atr_s2 : i_atr_s1

    // ③ トレーリングストップ（上方向のみ更新）
    _trail  = v_peak - _mult * atr_v
    v_stop := math.max(nz(v_stop, _trail), _trail)

    // ④ ハードストップ（-8%）を下限として最終ストップを確定
    v_fstop := math.max(v_stop, _avg * (1.0 - i_hard_stop))

    // ⑤ タイムストップ: 指定バー数経過 かつ 含み益が閾値未満 → 成行決済
    _bars_held = bar_index - nz(v_bar, bar_index)
    if _bars_held >= i_time_bars and _ret < i_time_ret
        strategy.close("long", comment="TS")
    else
        _exit_tag = _ret >= i_prof_s3 ? "S3" : _ret >= i_prof_s2 ? "S2" : "S1"
        strategy.exit("trail", from_entry="long", stop=v_fstop, comment=_exit_tag)

// ════════════════════════════════════════════
//  チャート描画
// ════════════════════════════════════════════

// EMA ライン
plot(ema_fast, "EMA5",  color=color.new(#2196F3, 0), linewidth=1)
plot(ema_mid,  "EMA25", color=color.new(#FF9800, 0), linewidth=1)
plot(ema_slow, "EMA75", color=color.new(#F44336, 0), linewidth=2)

// トレーリングストップライン（保有中のみ）
plot(v_fstop, "ストップ", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)

// ピーク高値ライン（ストップ基準の高値水準）
plot(in_long ? v_peak : na, "ピーク高値", color=color.new(color.teal, 55), style=plot.style_linebr, linewidth=1)

// エントリーシグナル三角マーク
plotshape(entry_ok and not in_long,
    title    = "エントリーシグナル",
    style    = shape.triangleup,
    location = location.belowbar,
    color    = color.new(color.lime, 0),
    size     = size.small)

// シグナル種別ラベル（ツールチップに RSI・ATR・出来高比）
if entry_ok and not in_long
    label.new(bar_index, na, sig_tag,
        xloc      = xloc.bar_index,
        yloc      = yloc.belowbar,
        style     = label.style_label_up,
        color     = color.new(color.green, 55),
        textcolor = color.white,
        size      = size.tiny,
        tooltip   = "Signal: "  + sig_tag
                  + "\nRSI: "   + str.tostring(math.round(rsi_v,  1))
                  + "\nATR: "   + str.tostring(math.round(atr_v,  1))
                  + "\nVol x: " + str.tostring(math.round(volume / vol_ma, 2)))

// ステージ背景色（緑: S1 / 青: S2 / 紫: S3）
_bg_ret = in_long ? (close - strategy.position_avg_price) / strategy.position_avg_price : na
_bg_col = _bg_ret >= i_prof_s3 ? color.new(color.purple, 92) : _bg_ret >= i_prof_s2 ? color.new(color.blue, 92) : in_long ? color.new(color.green, 95) : na
bgcolor(_bg_col, title="ステージ背景")

// ════════════════════════════════════════════
//  情報テーブル（右上）
// ════════════════════════════════════════════
var table tbl = table.new(position.top_right, 2, 6,
    bgcolor      = color.new(color.black, 78),
    border_color = color.new(color.gray, 40),
    border_width = 1,
    frame_color  = color.new(color.gray, 40))

if barstate.islast
    _avg_d   = strategy.position_avg_price
    _ret_pct = in_long ? (close - _avg_d) / _avg_d * 100.0 : 0.0

    string _stage = "─"
    if in_long
        _stage := _ret_pct / 100.0 >= i_prof_s3 ? "S3 中長期延長" : _ret_pct / 100.0 >= i_prof_s2 ? "S2 利益延長" : "S1 スイング"

    _ret_str  = in_long ? str.tostring(math.round(_ret_pct, 2)) + "%" : "─"
    _stop_str = in_long ? str.tostring(math.round(v_fstop,  1))       : "─"
    _bar_str  = in_long ? str.tostring(bar_index - nz(v_bar, bar_index)) : "─"
    _ret_col  = _ret_pct >= 0.0 ? color.lime : color.red
    _pos_col  = in_long ? color.lime : color.gray

    table.cell(tbl, 0, 0, "JPX-Swing",  text_color=color.silver,  text_size=size.small)
    table.cell(tbl, 1, 0, "情報",        text_color=color.silver,  text_size=size.small)
    table.cell(tbl, 0, 1, "ポジション",  text_color=color.gray,    text_size=size.tiny)
    table.cell(tbl, 1, 1, in_long ? "保有中" : "待機", text_color=_pos_col,  text_size=size.tiny)
    table.cell(tbl, 0, 2, "ステージ",   text_color=color.gray,    text_size=size.tiny)
    table.cell(tbl, 1, 2, _stage,        text_color=color.white,   text_size=size.tiny)
    table.cell(tbl, 0, 3, "含み益",      text_color=color.gray,    text_size=size.tiny)
    table.cell(tbl, 1, 3, _ret_str,      text_color=_ret_col,      text_size=size.tiny)
    table.cell(tbl, 0, 4, "ストップ",    text_color=color.gray,    text_size=size.tiny)
    table.cell(tbl, 1, 4, _stop_str,     text_color=color.red,     text_size=size.tiny)
    table.cell(tbl, 0, 5, "保有バー",    text_color=color.gray,    text_size=size.tiny)
    table.cell(tbl, 1, 5, _bar_str,      text_color=color.white,   text_size=size.tiny)
